#cloud-config
write_files:
  - path: /opt/demo/app.py
    content: |
      ${indent(6, app_py)}
  - path: /opt/demo/index.html
    content: |
      ${indent(6, index_html)}
  - path: /etc/systemd/system/demo.service
    content: |
      [Unit]
      Description=Demo Hackea a Uni
      After=network-online.target
      Wants=network-online.target

      [Service]
      Environment=AWS_REGION=${region}
      Environment=MODEL_ID=${model_id}
      Environment=GUARDRAIL_ID=${guardrail_id}
      Environment=GUARDRAIL_VERSION=${guardrail_version}
      Environment=SECRET_CODE=${secret_code}
      Environment=PORT=80
      ExecStart=/opt/demo/venv/bin/python /opt/demo/app.py
      DynamicUser=yes
      AmbientCapabilities=CAP_NET_BIND_SERVICE
      Restart=always
      RestartSec=3

      [Install]
      WantedBy=multi-user.target

runcmd:
  - dnf install -y python3.11 python3.11-pip
  - python3.11 -m venv /opt/demo/venv
  - /opt/demo/venv/bin/pip install --upgrade pip
  - /opt/demo/venv/bin/pip install "anthropic[bedrock]>=1.17,<2" boto3 qrcode
  - systemctl daemon-reload
  - systemctl enable --now demo
