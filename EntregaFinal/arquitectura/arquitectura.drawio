=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="430" y="560" width="64" height="64" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Agente&lt;/b&gt;&lt;br&gt;contenedor en&lt;br&gt;ECS Fargate&lt;br&gt;decide qué hacer" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="860" y="265" width="80" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Sandbox&lt;/b&gt;&lt;br&gt;contenedor en&lt;br&gt;ECS Fargate&lt;br&gt;ejecuta el código" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;spacingRight=6;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1"><mxGeometry x="860" y="545" width="80" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Cerebro&lt;/b&gt;&lt;br&gt;Claude Haiku 4.5 (Bedrock)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1200" y="180" width="72" height="72" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Memoria&lt;/b&gt;&lt;br&gt;pasos y conversación&lt;br&gt;(DynamoDB)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="72" height="72" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Archivos&lt;/b&gt;&lt;br&gt;CSV y gráficas (S3)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="1200" y="610" width="72" height="72" as="geometry"/></mxCell><mxCell id="c17" value="① Abre la página" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="② Sube el CSV&lt;br&gt;③ Pregunta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="② Sube el CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="② El CSV queda guardado en S3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c16"><mxGeometry x="0.1" relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="592"/><mxPoint x="570" y="760"/><mxPoint x="1345" y="760"/><mxPoint x="1345" y="646"/></Array></mxGeometry></mxCell><mxCell id="c21" value="③ La pregunta llega al agente" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c12"><mxGeometry x="0.35" relative="1" as="geometry"><Array as="points"><mxPoint x="590" y="436"/><mxPoint x="590" y="240"/><mxPoint x="900" y="240"/></Array></mxGeometry></mxCell><mxCell id="c22" value="④ Piensa con Claude" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="⑤ Manda el código a ejecutar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="⑥ Lee el CSV y guarda la gráfica" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="⑦ Guarda pasos y memoria" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;" edge="1" parent="1" source="c12" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="⑧ ¿Cómo va?" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="⑧ lee el avance" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#232F3E;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c10" target="c15"><mxGeometry x="-0.2" relative="1" as="geometry"><Array as="points"><mxPoint x="462" y="112"/><mxPoint x="1345" y="112"/><mxPoint x="1345" y="436"/></Array></mxGeometry></mxCell><mxCell id="c28" value="&lt;b style='font-size:15px'&gt;Cómo funciona, paso a paso&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;①&lt;/b&gt; El usuario abre la página web, que está guardada en S3.&lt;br&gt;&lt;br&gt;&lt;b&gt;②&lt;/b&gt; Sube su CSV. Una Lambda le da un permiso temporal y el archivo queda en S3.&lt;br&gt;&lt;br&gt;&lt;b&gt;③&lt;/b&gt; Escribe su pregunta. API Gateway la lleva al agente.&lt;br&gt;&lt;br&gt;&lt;b&gt;④&lt;/b&gt; El agente le pregunta a Claude qué hacer. Claude responde con código Python.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑤&lt;/b&gt; El agente manda ese código al sandbox, que está en una zona &lt;b&gt;sin internet&lt;/b&gt; por seguridad.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑥&lt;/b&gt; El sandbox lee el CSV, ejecuta el código y guarda la gráfica en S3. Si hay error, el agente vuelve a ④ y lo corrige.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑦&lt;/b&gt; Cada paso y la conversación quedan en DynamoDB: así recuerda lo que ya preguntaste.&lt;br&gt;&lt;br&gt;&lt;b&gt;⑧&lt;/b&gt; La página pregunta cada segundo &quot;¿cómo va?&quot; y muestra los pasos hasta la respuesta." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;fontSize=14;verticalAlign=top;spacingTop=8;align=left;spacingLeft=8;spacingRight=8;arcSize=6;" vertex="1" parent="1"><mxGeometry x="1420" y="90" width="400" height="690" as="geometry"/></mxCell><mxCell id="c29" value="Soporte de todas las piezas" style="fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;fontStyle=1;fontColor=#232F3E;whiteSpace=wrap;html=1;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="180" y="800" width="1200" height="130" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;ECR&lt;/b&gt; · guarda las imágenes&lt;br&gt;de los contenedores" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1"><mxGeometry x="290" y="835" width="48" height="48" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;CloudWatch&lt;/b&gt; · logs y&lt;br&gt;autoescalado (1 a 3 copias)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="640" y="835" width="48" height="48" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;IAM&lt;/b&gt; · cada pieza solo&lt;br&gt;tiene los permisos que necesita" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management;" vertex="1" parent="1"><mxGeometry x="990" y="835" width="48" height="48" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="tecnica" name="2. Vista técnica"><mxGraphModel dx="1800" dy="1100" g